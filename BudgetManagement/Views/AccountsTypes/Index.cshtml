@model IEnumerable<AccountType>
@{
    ViewData["Title"] = "Accounts Types";
}

<h1>Tipos Cuentas</h1>
<h5>El tipo de cuenta se refiere a cómo podemos agrupar cuentas.
    Ejemplos: Préstamos, Tarjetas de Crédito, Ahorros, etc.
</h5>
<a asp-action="Create" class="btn btn-primary">Crear nuevo</a>
<table id="accountsTypesTable" class="table">
    <thead>
        <tr>
            <th>Acciones</th>
            <th>Nombre</th>
        </tr>
    </thead>
    <tbody >
        @foreach (var accountType in Model)
        {
            <tr data-id="@accountType.Id">
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@accountType.Id" asp->Editar</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@accountType.Id">Borrar</a>
                </td>
                <td>
                    @accountType.Name
                </td>
            </tr>    
        }
    </tbody>
</table>
@section Scripts {
    <script>
        const tbody = document.querySelector("#accountsTypesTable tbody");

        // Habilitar drag & drop
        new Sortable(tbody, {
            animation: 150,
            ghostClass: 'bg-light',


            // Este evento se ejecuta cuando el usuario termina de arrastrar
            onEnd: function () {
                let orden = Array.from(document.querySelectorAll("#accountsTypesTable tbody tr"))
                .map((row) => (
                    parseInt(row.dataset.id)
                ));

                fetch('/AccountsTypes/Sortable', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(orden)
                })
                .then(res => {
                    if (!res.ok) {
                        alert("❌ Error al guardar el orden");
                    }
                });
            }

        });
    </script>
}


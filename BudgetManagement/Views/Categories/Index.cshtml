@model IEnumerable<Category>
@{
    ViewData["Title"] = "Categories";
}

<h1>Categorías</h1>
<h5>Las categorias ....

</h5>
<a class="btn btn-primary" asp-action="Create">Nuevo</a>

<table class="table">
    <thead>
        <tr>
            <th>Acciones</th>
            <th>Nombre</th>
            <th>Tipo</th>
        </tr>
    </thead>    
    <tbody>
        @foreach (var category in Model)
        {
          <tr>
              <td>
                  <a class="btn btn-primary" asp-action="Edit" asp-route-id="@category.Id">Editar</a>
                  <a class="btn btn-danger" asp-action="Delete" asp-route-id="@category.Id">Eliminar</a>
              </td>
              <td>
                  @category.Name
              </td>
              <td>
                  @category.TransactionTypeId
              </td>
          </tr>
        }
    </tbody>
</table>
